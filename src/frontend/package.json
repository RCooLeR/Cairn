{
  "name": "cairn-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node ./scripts/ensure-go-module-boundary.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:dev": "tsc --noEmit && vite build --configLoader runner --minify false --mode development",
    "build": "tsc --noEmit && vite build --configLoader runner --mode production",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=moderate",
    "test": "vitest run --configLoader runner",
    "test:release-ui": "playwright test --config playwright.config.mjs",
    "ladle": "ladle serve --host 127.0.0.1",
    "ladle:build": "ladle build",
    "build:release-ui": "tsc --noEmit && vite build --configLoader runner --mode release-validation",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@wailsio/runtime": "3.0.0-beta.24",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=12.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^24.13.6"
  },
  "overrides": {
    "dompurify": "^3.4.15",
    "@vitejs/plugin-react": "$@vitejs/plugin-react",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "vite": "$vite",
    "@ladle/react": {
      "react-inspector": "^9.0.0"
    }
  },
  "allowScripts": {
    "@swc/core@1.16.2": false,
    "msw@2.15.0": false
  }
}
