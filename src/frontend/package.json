{
  "name": "cairn-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node ./scripts/ensure-go-module-boundary.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:dev": "tsc --noEmit && vite build --configLoader runner --minify false --mode development",
    "build": "tsc --noEmit && vite build --configLoader runner --mode production",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=moderate",
    "test": "node --test scripts/ladle-glob/contract-check.mjs && vitest run --configLoader runner",
    "test:release-ui": "playwright test --config playwright.config.mjs",
    "ladle": "ladle serve --host 127.0.0.1",
    "ladle:build": "ladle build",
    "build:release-ui": "tsc --noEmit && vite build --configLoader runner --mode release-validation",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@wailsio/runtime": "3.1.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zustand": "^5.1.0"
  },
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=12.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "globby": "file:./scripts/ladle-glob",
    "jsdom": "^31.0.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "@vitejs/plugin-react": "$@vitejs/plugin-react",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "vite": "$vite",
    "@ladle/react": {
      "react-inspector": "^9.0.0",
      "globby": "$globby",
      "open": "^11.0.0"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.4"
    },
    "eslint": {
      "minimatch": "^11.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    }
  },
  "allowScripts": {
    "msw@2.15.0": false,
    "@swc/core@1.16.22": false
  }
}
