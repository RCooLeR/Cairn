{
  "name": "cairn-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node ./scripts/ensure-go-module-boundary.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:dev": "tsc --noEmit && vite build --configLoader runner --minify false --mode development",
    "build": "tsc --noEmit && vite build --configLoader runner --mode production",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=moderate",
    "test": "vitest run --configLoader runner",
    "test:release-ui": "playwright test --config playwright.config.mjs",
    "ladle": "ladle serve --host 127.0.0.1",
    "ladle:build": "ladle build",
    "build:release-ui": "tsc --noEmit && vite build --configLoader runner --mode release-validation",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@wailsio/runtime": "3.0.0-beta.15",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=24.20.0",
    "npm": ">=11.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "dompurify": "^3.4.13",
    "@vitejs/plugin-react": "$@vitejs/plugin-react",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "vite": "$vite"
  },
  "allowScripts": {
    "@swc/core@1.15.41": false,
    "msw@2.14.6": false
  }
}
