# Cross-compile Wails v3 apps with CGO
#
# Darwin: Zig + macOS SDK
# Linux: Native GCC only when the container architecture matches the target
# Windows: Zig + bundled mingw
#
# Usage from the repository root (build the frontend on the pinned host
# toolchain before entering the cross compiler):
#   npm --prefix frontend ci
#   npm --prefix frontend run build
#   docker build --build-arg GARBLE_VERSION=v0.17.1-0.20260828084131-08aa939fdc4b -t wails-cross -f build/docker/Dockerfile.cross build/docker/
#   docker run --rm -v $(pwd):/app wails-cross darwin arm64
#   docker run --rm -v $(pwd):/app wails-cross darwin amd64
#   docker run --rm -v $(pwd):/app wails-cross linux amd64
#   docker run --rm -v $(pwd):/app wails-cross windows amd64
#   docker run --rm -v $(pwd):/app wails-cross windows arm64

FROM golang:1.27.0-trixie@sha256:ae28539d2ef595b9a2930dd7f031d9592376829dc0eae7cb869559f7d5812c3a

ARG TARGETARCH
ARG GARBLE_VERSION

# Install base tools, GCC, and GTK/WebKit dev packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl xz-utils pkg-config gcc libc6-dev \
    libgtk-4-dev libwebkitgtk-6.0-dev \
    && pkg-config --atleast-version=4.14 gtk4 \
    && pkg-config --exists webkitgtk-6.0 \
    && rm -rf /var/lib/apt/lists/*

# Garble does not yet have a tagged Go 1.27-compatible release. The top-level
# task passes an immutable upstream pseudo-version until the next release.
RUN test -n "${GARBLE_VERSION}" \
    || (echo "GARBLE_VERSION build arg is required. Use the top-level setup:docker task." >&2; exit 1)
RUN go install mvdan.cc/garble@${GARBLE_VERSION}

# Install Zig - automatically selects correct binary for host architecture
ARG ZIG_VERSION=0.16.0
ARG ZIG_SHA256_X86_64=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
ARG ZIG_SHA256_AARCH64=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17
RUN ZIG_ARCH=$(case "${TARGETARCH}" in arm64) echo "aarch64" ;; *) echo "x86_64" ;; esac) && \
    ZIG_SHA256=$(case "${ZIG_ARCH}" in aarch64) echo "${ZIG_SHA256_AARCH64}" ;; *) echo "${ZIG_SHA256_X86_64}" ;; esac) && \
    curl -fsSL -o /tmp/zig.tar.xz "https://ziglang.org/download/${ZIG_VERSION}/zig-${ZIG_ARCH}-linux-${ZIG_VERSION}.tar.xz" && \
    echo "${ZIG_SHA256}  /tmp/zig.tar.xz" | sha256sum -c - && \
    tar -xJ -C /opt -f /tmp/zig.tar.xz && \
    rm /tmp/zig.tar.xz \
    && ln -s /opt/zig-${ZIG_ARCH}-linux-${ZIG_VERSION}/zig /usr/local/bin/zig

# Download macOS SDK (required for darwin targets)
ARG MACOS_SDK_VERSION=26.1
ARG MACOS_SDK_SHA256=beee7212d265a6d2867d0236cc069314b38d5fb3486a6515734e76fa210c784c
RUN curl -fsSL -o /tmp/macos-sdk.tar.xz "https://github.com/joseluisq/macosx-sdks/releases/download/${MACOS_SDK_VERSION}/MacOSX${MACOS_SDK_VERSION}.sdk.tar.xz" \
    && echo "${MACOS_SDK_SHA256}  /tmp/macos-sdk.tar.xz" | sha256sum -c - \
    && tar -xJ -C /opt -f /tmp/macos-sdk.tar.xz \
    && rm /tmp/macos-sdk.tar.xz \
    && mv /opt/MacOSX${MACOS_SDK_VERSION}.sdk /opt/macos-sdk

ENV MACOS_SDK_PATH=/opt/macos-sdk

# Create Zig CC wrappers for cross-compilation targets. Darwin and Windows use
# Zig; Linux uses native GCC and therefore must match the container architecture.
# Zig 0.16 derives the macOS deployment version from the target triple, so it
# is encoded there instead of relying on Clang's ignored version-min switch.

# Darwin arm64
COPY <<'ZIGWRAP' /usr/local/bin/zcc-darwin-arm64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -mmacosx-version-min=*|-mmacos-version-min=*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -fno-sanitize=all -target aarch64-macos.13.3-none -isysroot /opt/macos-sdk -I/opt/macos-sdk/usr/include -L/opt/macos-sdk/usr/lib -F/opt/macos-sdk/System/Library/Frameworks -w $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-darwin-arm64

# Darwin amd64
COPY <<'ZIGWRAP' /usr/local/bin/zcc-darwin-amd64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -mmacosx-version-min=*|-mmacos-version-min=*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -fno-sanitize=all -target x86_64-macos.13.3-none -isysroot /opt/macos-sdk -I/opt/macos-sdk/usr/include -L/opt/macos-sdk/usr/lib -F/opt/macos-sdk/System/Library/Frameworks -w $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-darwin-amd64

# Windows amd64 - uses Zig's bundled mingw
COPY <<'ZIGWRAP' /usr/local/bin/zcc-windows-amd64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -Wl,*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -target x86_64-windows-gnu $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-windows-amd64

# Windows arm64 - uses Zig's bundled mingw
COPY <<'ZIGWRAP' /usr/local/bin/zcc-windows-arm64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -Wl,*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -target aarch64-windows-gnu $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-windows-arm64

# Build script
COPY <<'SCRIPT' /usr/local/bin/build.sh
#!/bin/sh
set -e

OS=${1:-darwin}
ARCH=${2:-arm64}

case "${OS}-${ARCH}" in
    darwin-arm64|darwin-aarch64)
        export CC=zcc-darwin-arm64
        export GOARCH=arm64
        export GOOS=darwin
        export MACOSX_DEPLOYMENT_TARGET=13.3
        ;;
    darwin-amd64|darwin-x86_64)
        export CC=zcc-darwin-amd64
        export GOARCH=amd64
        export GOOS=darwin
        export MACOSX_DEPLOYMENT_TARGET=13.3
        ;;
    linux-amd64|linux-x86_64|linux-arm64|linux-aarch64)
        case "$(uname -m)" in
            x86_64) HOST_GOARCH=amd64 ;;
            aarch64|arm64) HOST_GOARCH=arm64 ;;
            *) echo "Unsupported Linux container architecture: $(uname -m)" >&2; exit 1 ;;
        esac
        case "${ARCH}" in
            amd64|x86_64) TARGET_GOARCH=amd64 ;;
            arm64|aarch64) TARGET_GOARCH=arm64 ;;
        esac
        if [ "${TARGET_GOARCH}" != "${HOST_GOARCH}" ]; then
            echo "Linux CGO target ${TARGET_GOARCH} requires a ${TARGET_GOARCH} cross image; this image is ${HOST_GOARCH}. Rebuild setup:docker on a matching host or use a native Linux runner." >&2
            exit 1
        fi
        export CC=gcc
        export GOARCH=${TARGET_GOARCH}
        export GOOS=linux
        ;;
    windows-arm64|windows-aarch64)
        export CC=zcc-windows-arm64
        export GOARCH=arm64
        export GOOS=windows
        ;;
    windows-amd64|windows-x86_64)
        export CC=zcc-windows-amd64
        export GOARCH=amd64
        export GOOS=windows
        ;;
    *)
        echo "Usage: <os> <arch>"
        echo "  os: darwin, linux, windows"
        echo "  arch: amd64, arm64"
        exit 1
        ;;
esac

export CGO_ENABLED=1
export CGO_CFLAGS="-w"

# The image intentionally contains no Node toolchain. The top-level build tasks
# produce the frontend with package-lock.json before mounting the repository.
# A tracked placeholder directory is not a valid application bundle.
if [ ! -f "frontend/dist/index.html" ]; then
    echo "frontend/dist/index.html is required; run the frontend production build before cross-compiling." >&2
    exit 1
fi

# Build
APP=${APP_NAME:-$(basename $(pwd))}
mkdir -p bin

EXT=""
LDFLAGS="-s -w -X github.com/RCooLeR/Cairn/internal/services.Version=${APP_VERSION:-1.0.0}"
if [ -n "$GIT_COMMIT" ]; then
    LDFLAGS="$LDFLAGS -X github.com/RCooLeR/Cairn/internal/services.Commit=$GIT_COMMIT"
fi
if [ -n "$BUILD_DATE" ]; then
    LDFLAGS="$LDFLAGS -X github.com/RCooLeR/Cairn/internal/services.BuildDate=$BUILD_DATE"
fi
if [ "$GOOS" = "windows" ]; then
    EXT=".exe"
    LDFLAGS="$LDFLAGS -H windowsgui"
fi

TAGS="production"
if [ -n "$EXTRA_TAGS" ]; then
    TAGS="${TAGS},${EXTRA_TAGS}"
fi

COMPILER="go build"
if [ "$OBFUSCATED" = "true" ]; then
    COMPILER="garble ${GARBLE_ARGS} build"
    TAGS="${TAGS},wails_obfuscated"
fi

${COMPILER} -mod=readonly -tags "$TAGS" -trimpath -buildvcs=false -ldflags="$LDFLAGS" -o bin/${APP}-${GOOS}-${GOARCH}${EXT} .
echo "Built: bin/${APP}-${GOOS}-${GOARCH}${EXT}"
SCRIPT
RUN chmod +x /usr/local/bin/build.sh

WORKDIR /app
ENTRYPOINT ["/usr/local/bin/build.sh"]
CMD ["darwin", "arm64"]
